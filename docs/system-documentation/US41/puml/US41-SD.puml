@startuml
' US41 – Record vaccine administration (complete pattern like US21)
autoactivate on
autonumber

actor "Nurse" as User
participant ":RecordVaccinationView" as View
participant ":RecordVaccinationController" as Ctrl
participant ":App" as App

participant "service:WaitingRoomService" as WaitingService
participant "service:VaccinationProcessService" as ProcessService

participant "factory:RepositoryFactory" as Factory
participant "repo:WaitingRoomRepository" as WaitingRepo
participant "repo:VaccinationProcessRepository" as ProcessRepo
participant "repo:VaccineRepository" as VaccineRepo

participant "dto:RecordVaccinationDto" as Dto
participant "proc:VaccinationProcess" as Process


activate User

' --- Start ---
User -> View: asks to record vaccine administration
View -> Ctrl: startRecord()

' --- (Optional) Get vaccines to select (pattern like US21) ---
Ctrl -> App: getVaccineService()
App -> Factory: getVaccineRepository()
Factory --> App: vaccineRepo
App --> "service:VaccineService"**: create(vaccineRepo)
App --> Ctrl: vaccineService

Ctrl -> "service:VaccineService": getAll()
"service:VaccineService" -> VaccineRepo: getAll()
VaccineRepo --> "service:VaccineService": vaccines
"service:VaccineService" --> Ctrl: vaccines

Ctrl -> "dtoList:List<VaccineDto>"**: create(vaccines)
Ctrl --> View: vaccineDtoList
View --> User: shows vaccines and requests data (snsUserNumber, vaccineId/code, lotNumber)

' --- User provides final data (selected vaccine + lot) ---

User -> View: types requested data
View -> Dto**: create(snsUserNumber, vaccineId/code, lotNumber)
View -> Ctrl: register(dto)

' --- Create services (same dependency injection pattern as US21) ---
Ctrl -> App: getWaitingRoomService()
App -> Factory: getWaitingRoomRepository()
Factory --> App: waitingRepo
App --> WaitingService**: create(waitingRepo)
App --> Ctrl: waitingService

Ctrl -> App: getVaccinationProcessService()
App -> Factory: getVaccinationProcessRepository()
Factory --> App: processRepo
App --> ProcessService**: create(processRepo)
App --> Ctrl: processService

' --- Domain rules (remove user from waiting room first) ---
Ctrl -> WaitingService: removeSNSUser(dto.snsUserNumber)
WaitingService -> WaitingRepo: removeSNSUser(dto.snsUserNumber)
WaitingRepo --> WaitingService: removed
WaitingService --> Ctrl: ok

' --- Ask confirmation (like your flow) ---
Ctrl --> View: show all data and request confirmation
View --> User: shows all data for confirmation
User -> View: confirms
View -> Ctrl: confirmRegistration()

' --- Create and persist vaccination process ---
Ctrl -> ProcessService: create(dto)
ProcessService --> Process**: create(dto)
ProcessService -> ProcessService: validate(proc)
ProcessService --> ProcessService: ok
ProcessService -> ProcessRepo: save(proc)
ProcessRepo --> ProcessService: result

' --- Post actions (assign to recovery room) ---
ProcessService -> ProcessService: assignToRecoveryRoom(dto.snsUserNumber)
ProcessService --> ProcessService: ok

ProcessService --> Ctrl: result(ok)
Ctrl --> View: result(ok)
View --> User: informs operation success

@enduml
